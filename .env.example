# Application
ENVIRONMENT=development
APP_NAME="Reliability Observatory"
DATABASE_URL=sqlite+aiosqlite:///./data/reliability.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
STATIC_DIR=

# Evaluation safety limits
MAX_RUN_CONCURRENCY=8
# Overall in-process task cap, including public deterministic demo runs.
MAX_ACTIVE_RUNS=4
MAX_DEMO_DELAY_MS=50
# Public-deployment guardrails for hosted model targets.
MAX_ACTIVE_LIVE_RUNS=1
MAX_LIVE_RUN_PROMPTS=6
TARGET_TIMEOUT_SECONDS=45
# Sleeping Hugging Face Spaces are warmed asynchronously before a run starts.
TARGET_WARMUP_SECONDS=180
ALLOW_PRIVATE_TARGET_URLS=false
# Required for live targets. Use comma-separated exact hosts or deliberate
# wildcards such as *.trusted-model-host.example.
TARGET_HOST_ALLOWLIST=

# Optional OpenAI-compatible target. Endpoint and model are selected per run;
# the credential remains server-side and is never accepted from the browser.
OPENAI_COMPATIBLE_API_KEY=

# Included free Gradio ZeroGPU Space. HUGGINGFACE_SPACE_API_KEY must match the
# Space's SPACE_API_KEY secret. HUGGINGFACE_TOKEN is an HF read token and is
# optional, but authenticated free calls receive the larger daily quota.
HUGGINGFACE_SPACE_API_KEY=
HUGGINGFACE_TOKEN=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
# Separate shared access key entered by trusted users when launching live runs.
# Keep it distinct from every provider and Space credential.
LIVE_RUN_ACCESS_KEY=

# Optional DeepEval judge. Install the backend `deepeval` extra first.
DEEPEVAL_MODEL=

# Build-time switch for Docker/Render. Rebuild after changing it.
INSTALL_OPTIONAL_INTEGRATIONS=false

# Optional LangSmith tracing. Evaluation still works when disabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reliability-observatory
