# Application
ENVIRONMENT=development
APP_NAME="Reliability Observatory"
DATABASE_URL=sqlite+aiosqlite:///./data/reliability.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
STATIC_DIR=

# Evaluation safety limits
MAX_RUN_CONCURRENCY=8
TARGET_TIMEOUT_SECONDS=45
ALLOW_PRIVATE_TARGET_URLS=false
# Required for live targets. Use comma-separated exact hosts or deliberate
# wildcards such as *.trusted-model-host.example.
TARGET_HOST_ALLOWLIST=

# Optional OpenAI-compatible target. Endpoint and model are selected per run;
# the credential remains server-side and is never accepted from the browser.
OPENAI_COMPATIBLE_API_KEY=

# Optional DeepEval judge. Install the backend `deepeval` extra first.
DEEPEVAL_MODEL=

# Build-time switch for Docker/Render. Rebuild after changing it.
INSTALL_OPTIONAL_INTEGRATIONS=false

# Optional LangSmith tracing. Evaluation still works when disabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reliability-observatory
